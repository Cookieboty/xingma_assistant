<view class="container">
  <view class="card head">
    <view class="section-title">询价</view>
    <view class="muted">员工与客户同权：待处理可先筛出来跟进</view>
  </view>
  <scroll-view scroll-x class="chips-row" enable-flex>
    <text
      class="chip {{status===item.id?'active':''}}"
      wx:for="{{statusChips}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onStatus"
    >{{item.name}}</text>
  </scroll-view>
  <view class="card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
    <view>{{item.title}}</view>
    <view class="muted" wx:if="{{item.contactName || item.phone}}">{{item.contactName || ''}} {{item.phone || ''}}</view>
    <view class="muted">{{item.statusLabel}} · {{item.content}}</view>
    <view class="muted" wx:if="{{item.handledNote}}">处理：{{item.handledNote}}</view>
  </view>
  <view class="card muted empty" wx:if="{{!list.length}}">
    <view wx:if="{{status==='open'}}">暂无待处理询价</view>
    <view wx:else>暂无询价</view>
  </view>
</view>
