<view class="container">
  <view class="card" wx:if="{{showProfile}}">
    <view class="section">我的资料</view>
    <view class="profile-row">
      <button
        class="avatar-pick"
        style="width:112rpx;height:112rpx;min-width:112rpx;min-height:112rpx;max-width:112rpx;max-height:112rpx;padding:0;margin:0;border-radius:12rpx;"
        open-type="chooseAvatar"
        bind:chooseavatar="onChooseAvatar"
      >
        <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="avatar-preview" style="width:112rpx;height:112rpx;" mode="aspectFill" />
        <view wx:else class="avatar-pick-inner">
          <text class="avatar-pick-text">微信头像</text>
        </view>
      </button>
      <view class="profile-main">
        <input
          class="input nick-input"
          type="nickname"
          placeholder="点选微信昵称"
          value="{{nickname}}"
          bindblur="onNickname"
          bindnicknamereview="onNicknameReview"
        />
      </view>
    </view>
    <view class="phone-row">
      <view class="phone-display">{{phone || '未绑定手机'}}</view>
      <button
        class="phone-wx-link"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
        disabled="{{phoneBinding}}"
      >微信获取</button>
    </view>
  </view>

  <view class="card" wx:if="{{canInvite}}">
    <view class="section">档口资料</view>
    <view class="sub-section">联系二维码</view>
    <view class="muted">展示在客户商品页底部，方便加微信；选图确认后自动保存</view>
    <image wx:if="{{contactQrUrl}}" src="{{contactQrUrl}}" mode="aspectFit" class="qr-preview" style="margin-top:16rpx;" />
    <view class="btn-ghost mini" style="margin-top:16rpx;" bindtap="pickContactQr">{{contactQrUrl ? '更换二维码' : '上传二维码'}}</view>
    <view class="link danger" wx:if="{{contactQrUrl}}" style="margin-top:12rpx;" bindtap="clearContactQr">清除</view>
  </view>

  <view class="card" wx:if="{{canInvite}}">
    <view class="section">当前成员</view>
    <view class="row item member-row" wx:for="{{members}}" wx:key="id">
      <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" class="member-avatar" mode="aspectFill" />
      <view wx:else class="member-avatar member-avatar-ph">{{item.nickShort}}</view>
      <view class="member-meta">
        <view class="member-name-row">
          <text class="member-name">{{item.displayName}}</text>
          <text class="tag" wx:if="{{item.id === myMemberId}}">我</text>
          <text class="tag">员工</text>
        </view>
        <view class="muted small">{{item.whoLine}}</view>
        <view class="muted small" wx:if="{{item.inviteCode}}">来自邀请 {{item.inviteCode}}</view>
      </view>
      <view class="ops" wx:if="{{item.id !== myMemberId}}">
        <text class="link danger" data-id="{{item.id}}" data-name="{{item.displayName}}" bindtap="kickMember">踢除</text>
      </view>
    </view>
    <view class="muted" wx:if="{{!members.length}}">暂无成员</view>
  </view>

  <view class="card" wx:if="{{canInvite}}">
    <view class="section">员工邀请</view>
    <view class="muted small" style="margin-top:8rpx;">默认邀请码最多 3 人使用；用满即失效。请用微信转发邀请同事加入（页上不展示码图）。</view>
    <view class="form" style="margin-top:16rpx;">
      <view class="btn-primary mini" bindtap="createInvite">生成邀请</view>
    </view>

    <view wx:if="{{latestInvite}}" class="invite-box">
      <view class="invite-code" bindtap="copyInviteCode" data-code="{{latestInvite.code}}">{{latestInvite.code}}</view>
      <view class="muted small">已用 {{latestInvite.useCount || 0}}/{{latestInvite.maxUses || 3}} · 点下方微信转发邀请同事加入</view>
      <button
        class="btn-primary mini invite-share-btn"
        open-type="share"
        data-code="{{latestInvite.code}}"
        data-url="{{latestInvite.wxacodeUrl}}"
        style="margin-top:16rpx;"
      >微信转发邀请</button>
      <view class="muted small" style="margin-top:8rpx;">也可复制邀请码，同事在邀请页手动填写</view>
    </view>

    <view class="section" style="margin-top:24rpx;">邀请记录</view>
    <view class="row item invite-record" wx:for="{{invites}}" wx:key="id">
      <view class="invite-meta">
        <text class="invite-code-text">{{item.code}}</text>
        <text class="muted" wx:if="{{item.status!=='active'}}"> · {{item.statusLabel}}</text>
        <text class="muted" wx:elif="{{item.maxUses}}"> · 已用{{item.useCount || 0}}/{{item.maxUses}}</text>
      </view>
      <view class="ops" wx:if="{{item.status==='active'}}">
        <button
          class="link invite-share-link"
          open-type="share"
          data-code="{{item.code}}"
          data-url="{{item.wxacodeUrl}}"
        >邀请</button>
        <text class="link danger" data-id="{{item.id}}" bindtap="revokeInvite">撤销</text>
      </view>
    </view>
    <view class="muted" wx:if="{{!invites.length}}">暂无邀请</view>
  </view>
</view>
