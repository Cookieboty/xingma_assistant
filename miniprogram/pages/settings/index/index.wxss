.section { font-weight: 600; margin-bottom: 8rpx; }
.item { justify-content: space-between; margin-top: 16rpx; padding-top: 12rpx; border-top: 1px solid #eee; }
.ops { display: flex; gap: 16rpx; }
.link { color: #3b82f6; font-size: 24rpx; }
.link.danger { color: #ef4444; }
.form { margin-top: 20rpx; }
.input { background: #f5f5f5; padding: 12rpx 16rpx; border-radius: 8rpx; margin-bottom: 12rpx; }
.mini { margin-top: 12rpx; text-align: center; padding: 16rpx; }
.tag { margin-left: 8rpx; font-size: 22rpx; background: #e0f2fe; color: #0369a1; padding: 2rpx 10rpx; border-radius: 8rpx; }

.avatar-btn { width: 120rpx; height: 120rpx; padding: 0; margin: 0; border-radius: 50%; overflow: hidden; background: #f0ebe6; line-height: 120rpx; font-size: 22rpx; color: #b08a70; }
.avatar-preview { width: 120rpx; height: 120rpx; }
.qr-preview { width: 240rpx; height: 240rpx; background: #fff; border-radius: 12rpx; }

.invite-box { margin-top: 20rpx; padding: 16rpx; background: #faf7f4; border-radius: 12rpx; }
.invite-code { font-size: 40rpx; font-weight: 700; letter-spacing: 4rpx; color: #c45c26; margin: 12rpx 0; }
