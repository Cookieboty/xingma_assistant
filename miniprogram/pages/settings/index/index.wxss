.section { font-weight: 600; margin-bottom: 8rpx; }
.item { justify-content: space-between; margin-top: 16rpx; padding-top: 12rpx; border-top: 1px solid #eee; }
.ops { display: flex; gap: 16rpx; }
.link { color: #3b82f6; font-size: 24rpx; }
.link.danger { color: #ef4444; }
.form { margin-top: 20rpx; }
.input { background: #f5f5f5; padding: 12rpx 16rpx; border-radius: 8rpx; margin-bottom: 12rpx; }
.mini { margin-top: 12rpx; text-align: center; padding: 16rpx; }
.tag { margin-left: 8rpx; font-size: 22rpx; background: #e0f2fe; color: #0369a1; padding: 2rpx 10rpx; border-radius: 8rpx; }

/* 我的资料：左头像 + 右昵称，手机手填 + 右侧「微信获取」链，与其它 card 一致 */
.profile-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  margin-top: 20rpx;
}
.avatar-pick {
  /* 严格正方形：压制 button 默认宽高/内边距，避免扁椭圆 */
  width: 112rpx !important;
  height: 112rpx !important;
  min-width: 112rpx !important;
  max-width: 112rpx !important;
  min-height: 112rpx !important;
  max-height: 112rpx !important;
  flex: 0 0 112rpx;
  padding: 0 !important;
  margin: 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  line-height: 112rpx;
  font-size: 0;
}
.avatar-pick::after { border: none; }
.avatar-pick-inner {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.avatar-pick-text { font-size: 22rpx; color: #999; text-align: center; line-height: 1.2; }
.avatar-preview {
  width: 112rpx !important;
  height: 112rpx !important;
  display: block;
  border-radius: 12rpx;
}
.profile-main { flex: 1; min-width: 0; }
.nick-input { margin-bottom: 0; }
.phone-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}
.phone-input {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}
.phone-display {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #333;
  padding: 12rpx 0;
}
.profile-guide { margin-top: 8rpx; font-size: 22rpx; }
.phone-wx-link {
  flex-shrink: 0;
  height: auto;
  min-height: 0;
  padding: 0 4rpx;
  margin: 0;
  background: transparent;
  color: #576b95;
  font-size: 26rpx;
  line-height: 1.4;
  border: none;
  border-radius: 0;
  box-sizing: border-box;
}
.phone-wx-link::after { border: none; }
.phone-wx-link[disabled] { color: #b0b8c8; }

.qr-preview { width: 240rpx; height: 240rpx; background: #fff; border-radius: 12rpx; }

.invite-box { margin-top: 20rpx; padding: 16rpx; background: #faf7f4; border-radius: 12rpx; }
.invite-code { font-size: 40rpx; font-weight: 700; letter-spacing: 4rpx; color: #c45c26; margin: 12rpx 0; }

.sub-section {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #444;
}
