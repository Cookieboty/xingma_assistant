.page {
  min-height: 100vh;
  background: #f6f3f0;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}
.hint {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}
.card {
  width: calc(50% - 20rpx);
  margin: 0 10rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.cover {
  width: 100%;
  height: 320rpx;
  background: #efe8e2;
  display: block;
}
.body {
  padding: 16rpx 18rpx 20rpx;
}
.name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a8a8a;
}
.price {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #c45c26;
  font-weight: 600;
}
.empty {
  margin-top: 120rpx;
  text-align: center;
  color: #8a8a8a;
  font-size: 28rpx;
}
.footer {
  text-align: center;
  color: #8a8a8a;
  font-size: 24rpx;
  padding: 24rpx 0;
}
