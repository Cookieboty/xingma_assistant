.page {
  min-height: 100vh;
  background: #f5f2ef;
  padding: 20rpx 20rpx 56rpx;
  box-sizing: border-box;
}
.head {
  padding: 8rpx 8rpx 20rpx;
}
.head-title {
  font-size: 34rpx;
  font-weight: 650;
  color: #1f1a17;
  line-height: 1.3;
}
.head-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a8178;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.card {
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(40, 28, 18, 0.05);
}
.cover-wrap {
  width: 100%;
  padding-top: 100%;
  position: relative;
  background: #efe8e2;
}
.cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}
.cover-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b5aea8;
  font-size: 24rpx;
}
.body {
  padding: 18rpx 18rpx 22rpx;
}
.style {
  font-size: 26rpx;
  font-weight: 560;
  color: #2a2420;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.price {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #c45c26;
  letter-spacing: 0.4rpx;
}
.price.muted {
  color: #8a8178;
  font-size: 26rpx;
  font-weight: 500;
}
.empty {
  margin-top: 160rpx;
  text-align: center;
  color: #8a8178;
  font-size: 28rpx;
}
.footer {
  text-align: center;
  color: #8a8178;
  font-size: 24rpx;
  padding: 28rpx 0 8rpx;
}
