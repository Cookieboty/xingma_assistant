<view class="container">
  <view class="card muted" wx:if="{{loading}}">加载中…</view>

  <!-- 0. 选模板 -->
  <block wx:if="{{!loading && !tpl}}">
    <view class="card">
      <view class="section-title">{{mediaKind === 'video' ? '选择视频模板' : '选择出图模板'}}</view>
      <view class="muted">{{mediaKind === 'video' ? '竖版约 8～12 秒：选图 → 卖点 → 编辑分镜 → 生成一条' : '不同用途的出图方式、步骤和提示词都不同'}}</view>
    </view>
    <view class="card tpl" wx:for="{{templates}}" wx:key="id" data-id="{{item.id}}" bindtap="pickTemplate">
      <view class="tpl-head">
        <text class="tpl-name">{{item.name}}</text>
        <text class="tag" wx:for="{{item.platforms}}" wx:for-item="p" wx:key="*this">{{p === 'xiaohongshu' ? '小红书' : '朋友圈'}}</text>
      </view>
      <view class="muted" style="margin-top:8rpx;">{{item.desc}}</view>
      <view class="muted small" style="margin-top:8rpx;">{{item.model === 'none' ? '无需模特' : (item.model === 'required' ? '需选模特' : '模特可选')}} · {{item.id === 'multi_color' ? '按颜色出图' : (item.count.min + '-' + item.count.max + ' 张')}}</view>
    </view>
  </block>

  <!-- 步骤 -->
  <block wx:if="{{tpl && stepKey !== 'result'}}">
    <view class="card">
      <view class="tpl-head"><text class="tpl-name">{{tpl.name}}</text><text class="link" bindtap="backToTemplates">换模板</text></view>
      <view class="progress">
        <text wx:for="{{steps}}" wx:key="*this" class="dot {{index <= stepIdx ? 'on' : ''}}">{{stepNames[item]}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{stepKey === 'reference'}}">
      <view class="section-title">{{stepNames.reference}}</view>
      <view class="section-hint">{{tpl.reference.hint}} · 可多选（已选 {{sel.refs.length}}/{{tpl.reference.max}}）</view>
      <view class="grid">
        <view class="cell {{item.checked ? 'checked' : ''}}" wx:for="{{assets}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleRef" bindlongpress="previewAsset" data-url="{{item.url}}">
          <image src="{{item.url}}" mode="aspectFill" lazy-load />
          <view class="check {{item.checked ? 'on' : ''}}">{{item.checked ? item.order : ''}}</view>
          <view class="mark" wx:if="{{item.isPromo}}">AI</view>
        </view>
      </view>
      <view class="muted small">点选切换勾选（可多张）· 长按预览{{quickMode ? ' · 已自动勾选主图' : ''}}</view>
      <view class="quick-bar" wx:if="{{quickMode}}" style="margin-top:16rpx;">
        <view class="muted small">短路径：默认 1 张、姿势/场景用模板预设。特征与张数等可展开。</view>
        <view class="link" style="margin-top:8rpx;" bindtap="showMoreOptions">更多选项</view>
      </view>

      <!-- 风格样例：仅 style_ref（styleRef.max>0）必传；其它模板不展示。视频一期不做 -->
      <view class="style-ref-block" wx:if="{{mediaKind !== 'video' && tpl.styleRef && tpl.styleRef.max > 0}}">
        <view class="sub-label">风格样例（必传）</view>
        <view class="section-hint">{{tpl.styleRef.hint || '上传你要照着出的成片样例；衣服仍以商品图为准'}} · {{styleRefs.length}}/{{tpl.styleRef.max || styleRefMax}}</view>
        <view class="grid">
          <view class="cell style-cell" wx:for="{{styleRefs}}" wx:key="index" data-index="{{index}}">
            <image src="{{item.url}}" mode="aspectFill" lazy-load data-url="{{item.url}}" bindtap="previewStyleRef" />
            <view class="style-del" data-index="{{index}}" catchtap="removeStyleRef">×</view>
            <view class="mark" wx:if="{{item.uploading}}">上传中</view>
          </view>
          <view
            class="cell style-add {{styleRefs.length >= styleRefMax || styleUploading ? 'disabled' : ''}}"
            bindtap="addStyleRef"
            wx:if="{{styleRefs.length < styleRefMax}}"
          >
            <text class="style-add-plus">＋</text>
            <text class="style-add-txt">{{styleUploading ? '上传中…' : '上传风格样例'}}</text>
          </view>
        </view>
        <view class="sub-label" style="margin-top:8rpx;">风格强弱</view>
        <view class="chips">
          <text
            class="chip {{styleStrength === item.id ? 'on' : ''}}"
            wx:for="{{styleStrengthOpts}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="pickStyleStrength"
          >{{item.name}}</text>
        </view>
        <view class="muted small">弱=轻微借鉴光影；中=默认；强=更像样例构图氛围。衣服始终以商品参考图为准，不会抄样例人脸/品牌。</view>
      </view>
    </view>

    <view class="card" wx:if="{{stepKey === 'colors'}}">
      <view class="section-title">{{stepNames.colors}}</view>
      <view class="section-hint">{{tpl.id === 'multi_color' ? '按参考图顺序选对应颜色（几色出几张，须与参考图数量一致）' : '按参考图顺序选对应颜色（可不选，则由模型按图识别）'}}</view>
      <view class="chips">
        <text class="chip {{item.checked ? 'on' : ''}}" wx:for="{{colors}}" wx:key="name" data-name="{{item.name}}" bindtap="toggleColor">{{item.name}}</text>
      </view>
      <view class="muted small" wx:if="{{sel.colors.length}}">顺序：{{sel.colors}}</view>
    </view>

    <view class="card" wx:if="{{stepKey === 'feature'}}">
      <view class="section-title">{{mediaKind === 'video' ? '卖点 / 特征' : stepNames.feature}}</view>
      <block wx:if="{{mediaKind === 'video'}}">
        <view class="section-hint">可选填一句话卖点（写入分镜）；下方商品特征可改，不会画成字幕</view>
        <input class="input" maxlength="200" placeholder="一句话卖点，例如：软糯亲肤，通勤也能穿" value="{{sellingPoint}}" bindinput="onSellingPoint" />
        <view class="sub-label" style="margin-top:16rpx;">商品特征</view>
      </block>
      <view class="section-hint" wx:else>根据商品信息自动生成，可修改；仅作提示，不会画进图里</view>
      <textarea class="textarea" style="height:{{mediaKind === 'video' ? '240rpx' : '360rpx'}};" maxlength="2000" value="{{feature}}" bindinput="onFeature" />
    </view>

    <view class="card" wx:if="{{stepKey === 'script'}}">
      <view class="section-title">{{stepNames.script}}</view>
      <view class="section-hint">约 {{scriptSeconds || 10}} 秒竖屏分镜草稿。改这里就会进成片；确认后再生成视频</view>
      <view class="muted small" wx:if="{{scriptLoading}}">处理中…</view>
      <textarea class="textarea" style="height:420rpx;" maxlength="1200" placeholder="改这里就会进成片" value="{{script}}" bindinput="onScript" disabled="{{scriptLoading}}" />
      <view class="script-actions" style="margin-top:12rpx;display:flex;gap:24rpx;align-items:center;">
        <view class="link" bindtap="refreshScript">规则草稿</view>
        <view class="link" bindtap="polishScript">润色</view>
      </view>
      <view class="muted small" wx:if="{{scriptVia}}">来源：{{scriptVia === 'llm' ? '智能润色' : '规则草稿（即时）'}}</view>
    </view>

    <view class="card" wx:if="{{stepKey === 'model'}}">
      <view class="section-title">{{stepNames.model}}{{tpl.model === 'optional' ? '（可不选）' : ''}}</view>
      <view class="section-hint">点选头像卡片选择模特</view>
      <view class="model-grid">
        <view
          class="model-card {{sel.modelId === item.id ? 'on' : ''}}"
          wx:for="{{models}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="pickModel"
        >
          <image class="model-avatar" src="{{item.avatar}}" mode="aspectFill" />
          <text class="model-name">{{item.name}}</text>
          <text class="model-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- 兼容旧 steps：单独 pose / scene -->
    <view class="card" wx:if="{{stepKey === 'pose'}}">
      <view class="section-title">{{stepNames.pose}}</view>
      <view class="section-hint">{{singlePoseScene ? '整组共用同一姿势（单选）' : '可多选，多张图会轮换使用'}}</view>
      <view class="chips">
        <text class="chip {{item.on ? 'on' : ''}}" wx:for="{{poseOpts}}" wx:key="id" data-kind="poses" data-id="{{item.id}}" bindtap="toggleMulti">{{item.name}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{stepKey === 'scene'}}">
      <view class="section-title">{{tpl.sceneLabel}}</view>
      <view class="section-hint">{{singlePoseScene ? '整组共用同一场景（单选）' : '可多选，多张图会轮换使用'}}</view>
      <view class="chips">
        <text class="chip {{item.on ? 'on' : ''}}" wx:for="{{sceneOpts}}" wx:key="id" data-kind="scenes" data-id="{{item.id}}" bindtap="toggleMulti">{{item.name}}</text>
      </view>
    </view>

    <!-- 合并步：姿势 + 场景 + 自由描述 + 语音 -->
    <view class="card" wx:if="{{stepKey === 'pose_scene'}}">
      <view class="section-title">姿势与场景</view>
      <view class="section-hint">{{singlePoseScene ? '整组共用同一姿势与场景（单选）；也可自己描述' : '可点选预设（多选会轮换）；也可打字或语音补充'}}</view>

      <block wx:if="{{poseOpts.length}}">
        <view class="sub-label">姿势 / 呈现</view>
        <view class="chips">
          <text class="chip {{item.on ? 'on' : ''}}" wx:for="{{poseOpts}}" wx:key="id" data-kind="poses" data-id="{{item.id}}" bindtap="toggleMulti">{{item.name}}</text>
        </view>
        <view class="free-row">
          <textarea class="free-input" maxlength="200" placeholder="可整句描述，如：在咖啡馆门口靠着墙眼睛微眯看着远方的英伦风" value="{{sel.poseText}}" bindinput="onPoseText" />
          <view
            class="voice-btn {{voiceListening && voiceTarget==='pose' ? 'on' : ''}}"
            data-target="pose"
            bindtouchstart="onVoiceStart"
            bindtouchend="onVoiceEnd"
            bindtouchcancel="onVoiceCancel"
          >{{voiceListening && voiceTarget==='pose' ? '松手' : '按住说话'}}</view>
        </view>
      </block>

      <block wx:if="{{sceneOpts.length}}">
        <view class="sub-label" style="margin-top:24rpx;">{{tpl.sceneLabel || '场景'}}</view>
        <view class="chips">
          <text class="chip {{item.on ? 'on' : ''}}" wx:for="{{sceneOpts}}" wx:key="id" data-kind="scenes" data-id="{{item.id}}" bindtap="toggleMulti">{{item.name}}</text>
        </view>
        <view class="free-row">
          <textarea class="free-input" maxlength="200" placeholder="场景可写在上面一句里，或单独补充：秋日公园落叶 / 暖色窗边" value="{{sel.sceneText}}" bindinput="onSceneText" />
          <view
            class="voice-btn {{voiceListening && voiceTarget==='scene' ? 'on' : ''}}"
            data-target="scene"
            bindtouchstart="onVoiceStart"
            bindtouchend="onVoiceEnd"
            bindtouchcancel="onVoiceCancel"
          >{{voiceListening && voiceTarget==='scene' ? '松手' : '按住说话'}}</view>
        </view>
      </block>
    </view>

    <view class="card" wx:if="{{stepKey === 'style_keywords'}}">
      <view class="section-title">风格关键词</view>
      <view class="section-hint">根据风格样例自动提取，可改可删；分析失败可留空，仍按样例图生成</view>
      <view class="muted small" wx:if="{{styleAnalyzing}}">正在分析风格样例…</view>
      <view class="chips" wx:if="{{styleKeywordChips.length}}">
        <text
          class="chip"
          wx:for="{{styleKeywordChips}}"
          wx:key="*this"
          data-name="{{item}}"
          bindtap="toggleStyleChip"
        >{{item}}</text>
      </view>
      <textarea
        class="textarea"
        style="height:220rpx;margin-top:16rpx;"
        maxlength="500"
        placeholder="场景 / 有无模特 / 景别 / 氛围 / 背景…可自由改"
        value="{{styleKeywordsText}}"
        bindinput="onStyleKeywordsText"
      />
      <view class="link" style="margin-top:12rpx;" bindtap="reAnalyzeStyle">重新分析样例</view>
      <view class="muted small" style="margin-top:8rpx;">衣服始终以商品参考图为准；不会抄样例人脸或品牌 logo。</view>
    </view>

    <view class="card" wx:if="{{stepKey === 'count'}}">
      <view class="section-title">{{stepNames.count}}</view>
      <view class="counter">
        <text class="cbtn" bindtap="countMinus">－</text><text class="cnum">{{sel.count}}</text><text class="cbtn" bindtap="countPlus">＋</text>
        <text class="muted small">（{{tpl.count.min}}-{{tpl.count.max}} 张，每张约 30-60 秒）</text>
      </view>
      <view class="opt {{sel.sizeId === item.id ? 'on' : ''}}" wx:for="{{tpl.sizeOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="pickSize">
        <text class="opt-name">{{item.name}}</text>
      </view>
    </view>

    <view class="footer">
      <view class="btn-weak half" bindtap="prev">{{quickMode && stepIdx === 0 ? '换模板' : '上一步'}}</view>
      <view class="btn-primary half" bindtap="next">{{stepIdx >= steps.length - 1 ? (submitting ? '提交中…' : (styleUploading ? '上传中…' : (mediaKind === 'video' ? '确认生成视频' : '开始生成'))) : '下一步'}}</view>
    </view>
  </block>

  <!-- 结果 -->
  <block wx:if="{{stepKey === 'result' && job}}">
    <view class="card">
      <view class="section-title">{{tpl.name}} · {{job.status === 'done' || job.status === 'succeeded' ? '已完成' : (job.status === 'failed' ? '生成失败' : (job.status === 'partial' ? '部分完成' : (job.status === 'queued' ? '排队中…' : '生成中…')))}}</view>
      <view class="muted">{{mediaKind === 'video' ? (job.done + ' / ' + job.total + ' 条视频') : (job.done + ' / ' + job.total + ' 张')}}</view>
      <view class="album-bar" wx:if="{{job.done && mediaKind !== 'video'}}">
        <text class="link" bindtap="toggleSelectAllAlbum">{{albumAllSelected ? '取消全选' : '全选'}}</text>
        <text class="muted">已选 {{albumSelectedCount}} 张 · 点勾选，点图预览</text>
      </view>
      <block wx:if="{{mediaKind === 'video'}}">
        <view wx:for="{{job.items}}" wx:key="index" class="video-result">
          <video wx:if="{{item.url}}" class="promo-video" src="{{item.url}}" controls show-center-play-btn object-fit="contain"></video>
          <view class="placeholder" wx:elif="{{item.status === 'failed'}}">失败：{{item.error || ''}}</view>
          <view class="placeholder" wx:else>视频生成中，通常 1～3 分钟…</view>
          <view
            class="check {{item.albumSelected ? 'on' : ''}}"
            wx:if="{{item.url}}"
            data-index="{{index}}"
            catchtap="toggleAlbumItem"
            style="margin-top:12rpx;"
          >{{item.albumSelected ? '✓ 已选以下载' : '勾选以下载到相册'}}</view>
        </view>
      </block>
      <view class="grid" wx:else>
        <view class="cell big {{item.albumSelected ? 'checked' : ''}}" wx:for="{{job.items}}" wx:key="index">
          <image wx:if="{{item.url}}" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="previewResult" />
          <view class="placeholder" wx:elif="{{item.status === 'failed'}}">失败</view>
          <view class="placeholder" wx:else>生成中…</view>
          <view
            class="check {{item.albumSelected ? 'on' : ''}}"
            wx:if="{{item.url}}"
            data-index="{{index}}"
            catchtap="toggleAlbumItem"
          >{{item.albumSelected ? '✓' : ''}}</view>
          <view class="mark" wx:if="{{item.saved}}">已存</view>
        </view>
      </view>
    </view>
    <view class="caption-box" wx:if="{{job.caption && (job.status==='done' || job.status==='partial' || job.status==='succeeded')}}">
      <view class="caption-head">
        <text class="caption-title">种草文案（已关联商品）</text>
        <text class="link" bindtap="copyCaption">一键复制</text>
      </view>
      <text class="caption-body" user-select>{{job.caption}}</text>
    </view>
    <view class="footer footer-3">
      <view class="btn-weak" bindtap="again">再来一组</view>
      <view
        class="btn-ghost {{savingAlbum ? 'disabled' : ''}}"
        wx:if="{{job.done || job.status==='partial' || job.status==='succeeded'}}"
        bindtap="saveToAlbum"
      >{{savingAlbum ? '保存中…' : albumSaveLabel}}</view>
      <view class="btn-primary" wx:if="{{job.done || job.status==='partial' || job.status==='succeeded'}}" bindtap="goGallery">{{mediaKind === 'video' ? '查看素材' : '查看图组'}}</view>
    </view>
  </block>
</view>
