.tpl-head { display: flex; align-items: center; gap: 12rpx; justify-content: space-between; }
.tpl-name { font-size: 32rpx; font-weight: 700; flex: 1; }
.small { font-size: 22rpx; }
.progress { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }
.dot { font-size: 22rpx; padding: 6rpx 14rpx; border-radius: 999rpx; background: #f0ebe6; color: #9a8f86; }
.dot.on { background: #c45c26; color: #fff; }
.grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0; }
.cell { position: relative; width: 200rpx; height: 200rpx; border-radius: 16rpx; overflow: hidden; border: 4rpx solid transparent; background: #f6f3f0; }
.cell.big { width: 316rpx; height: 420rpx; }
.cell image { width: 100%; height: 100%; }
.cell.checked { border-color: #c45c26; }
.badge { position: absolute; top: 8rpx; right: 8rpx; width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; border-radius: 50%; background: #c45c26; color: #fff; font-size: 24rpx; }
.mark { position: absolute; left: 8rpx; bottom: 8rpx; font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 8rpx; background: rgba(0,0,0,.5); color: #fff; }
.placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #9a8f86; font-size: 26rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 12rpx; }
.chips .chip { padding: 12rpx 24rpx; border-radius: 999rpx; background: #f6f3f0; font-size: 26rpx; border: 2rpx solid transparent; }
.chips .chip.on { background: #fbeee6; color: #c45c26; border-color: #c45c26; }
.opt { display: flex; flex-direction: column; gap: 6rpx; padding: 20rpx; margin-top: 14rpx; border-radius: 16rpx; background: #f6f3f0; border: 2rpx solid transparent; }
.opt.on { background: #fbeee6; border-color: #c45c26; }
.opt-name { font-size: 28rpx; font-weight: 600; }
.counter { display: flex; align-items: center; gap: 20rpx; margin: 16rpx 0; }
.cbtn { width: 64rpx; height: 64rpx; line-height: 64rpx; text-align: center; border-radius: 50%; background: #f6f3f0; font-size: 34rpx; }
.cnum { font-size: 40rpx; font-weight: 700; min-width: 48rpx; text-align: center; }
.footer { display: flex; gap: 20rpx; margin-top: 20rpx; padding-bottom: 40rpx; }
.half { flex: 1; }

.check {
  position: absolute; top: 8rpx; right: 8rpx;
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  border-radius: 50%; border: 3rpx solid rgba(255,255,255,.95);
  background: rgba(0,0,0,.25); color: #fff; font-size: 22rpx; box-sizing: border-box;
}
.check.on { background: #c45c26; border-color: #c45c26; }

.album-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
  padding: 8rpx 0 0;
}
.footer-3 {
  flex-wrap: wrap;
}
.footer-3 > view {
  flex: 1;
  min-width: 200rpx;
  box-sizing: border-box;
}
.footer-3 .btn-ghost.disabled,
.footer-3 .btn-primary.disabled {
  opacity: 0.45;
  pointer-events: none;
}
.cell.big .check {
  z-index: 2;
}

.caption-box {
  margin: 16rpx 24rpx;
  padding: 16rpx;
  background: #faf7f4;
  border-radius: 12rpx;
}
.caption-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.caption-title { font-size: 26rpx; font-weight: 600; color: #5c4a3a; }
.caption-body {
  font-size: 24rpx;
  color: #6b5b4f;
  white-space: pre-wrap;
  line-height: 1.5;
}
.link { color: #c45c26; font-size: 26rpx; }

.model-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 16rpx;
}
.model-card {
  width: 200rpx;
  padding: 12rpx 12rpx 16rpx;
  border-radius: 20rpx;
  background: #f6f3f0;
  border: 4rpx solid transparent;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.model-card.on {
  border-color: #c45c26;
  background: #fbeee6;
  box-shadow: 0 0 0 4rpx rgba(196, 92, 38, 0.18);
}
.model-avatar {
  width: 160rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #e8e2dc;
}
.model-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #3d3229;
  text-align: center;
  line-height: 1.3;
}
.model-desc {
  font-size: 20rpx;
  color: #9a8f86;
  text-align: center;
  line-height: 1.2;
}

.sub-label {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #5c4a3a;
}
.free-row {
  display: flex;
  gap: 12rpx;
  align-items: stretch;
  margin-top: 12rpx;
}
.free-input {
  flex: 1;
  min-height: 120rpx;
  padding: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #ebe4dc;
  font-size: 26rpx;
  color: #3d3229;
  box-sizing: border-box;
}
.voice-btn {
  width: 140rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 12rpx;
  border-radius: 12rpx;
  background: #f6f3f0;
  color: #c45c26;
  font-size: 22rpx;
  font-weight: 600;
  border: 2rpx solid #e8d9ce;
  box-sizing: border-box;
}
.voice-btn.on {
  background: #c45c26;
  color: #fff;
  border-color: #c45c26;
}

.style-ref-block {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx dashed #ebe4dc;
}
.style-cell .style-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  z-index: 2;
}
.style-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 3rpx dashed #d9cfc5;
  background: #faf7f4;
  box-sizing: border-box;
}
.style-add.disabled {
  opacity: 0.45;
  pointer-events: none;
}
.style-add-plus {
  font-size: 44rpx;
  color: #c45c26;
  line-height: 1;
}
.style-add-txt {
  font-size: 20rpx;
  color: #9a8f86;
  text-align: center;
  padding: 0 8rpx;
}

.video-result { margin-top: 16rpx; }
.promo-video { width: 100%; height: 720rpx; background: #111; border-radius: 12rpx; }

.style-ref-block .sub-label {
  color: #3d3229;
}

.input {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  background: #f7f7f8;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.sub-label { font-size: 26rpx; color: #666; margin-bottom: 8rpx; }

.tpl-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.tpl-head-left { display: flex; align-items: center; gap: 12rpx; flex: 1; min-width: 0; }
.tpl-switch { flex-shrink: 0; padding: 8rpx 20rpx !important; font-size: 24rpx !important; }
.quick-links .link { color: #c45c26; }


.beat-list { margin-top: 12rpx; display: flex; flex-direction: column; gap: 16rpx; }
.beat-card {
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f6f3f0;
  border: 2rpx solid #ebe4dc;
}
.beat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.beat-idx { font-size: 26rpx; font-weight: 600; color: #3d3229; }
.beat-ops { display: flex; gap: 16rpx; }
.beat-ops .danger { color: #c0392b; }
.beat-sec-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 8rpx 0 12rpx;
}
.beat-sec-input {
  width: 120rpx;
  padding: 8rpx 16rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
}
.beat-text { background: #fff; }
.footer .btn-ghost.half {
  box-sizing: border-box;
}
