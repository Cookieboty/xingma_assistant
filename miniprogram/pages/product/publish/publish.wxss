.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.img-cell {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  background: #f0ebe6;
}
.img-cell .thumb { width: 100%; height: 100%; }
.img-cell.add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #e0b8a0;
  background: #fffaf7;
}
.add-plus { font-size: 48rpx; color: #c45c26; line-height: 1; }
.add-txt { font-size: 22rpx; color: #8a8a8a; margin-top: 4rpx; }
.img-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
}
.role-tag {
  position: absolute;
  left: 8rpx; right: 8rpx; bottom: 8rpx;
  background: rgba(26,26,46,0.72);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  padding: 6rpx 0;
  border-radius: 8rpx;
}
.btn-block-footer.dual {
  display: flex;
  gap: 16rpx;
}
.btn-block-footer .half { flex: 1; }
.seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 12rpx;
  background: #f0ebe6;
  color: #666;
  font-size: 26rpx;
}
.seg-item.on {
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-weight: 600;
}
