.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 24rpx;
}
.toolbar-left { min-width: 0; flex: 1; }
.toolbar-title { margin-bottom: 4rpx; }
.tiny { font-size: 22rpx; }
.toolbar-actions { display: flex; gap: 12rpx; flex-shrink: 0; }
.tool-btn {
  padding: 14rpx 22rpx;
  font-size: 24rpx;
  white-space: nowrap;
  border-radius: 12rpx;
}

.search-bar { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 20rpx; }
.search-bar .input { flex: 1; min-height: 64rpx; padding: 12rpx 20rpx; margin: 0; }
.search-btn { color: var(--color-primary); font-weight: 600; font-size: 28rpx; padding: 12rpx 8rpx; white-space: nowrap; }

.filters { display: flex; flex-wrap: nowrap; gap: 12rpx; margin-bottom: 8rpx; padding: 0 4rpx 12rpx; overflow-x: auto; }

.product-card {
  padding: 0;
  overflow: hidden;
  margin-bottom: 20rpx;
}
.pc-body {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  align-items: stretch;
}
.pc-cover-wrap {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  flex-shrink: 0;
}
.pc-cover {
  width: 176rpx;
  height: 176rpx;
  border-radius: 16rpx;
  background: #efeceb;
  display: block;
}
.pc-cover-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b5aea8;
  font-size: 22rpx;
  box-sizing: border-box;
}
.pc-badge {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  background: rgba(26, 26, 46, 0.72);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}
.pc-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 2rpx 0;
}
.pc-name-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.pc-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.pc-style {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}
.pc-meta {
  margin-top: 8rpx;
  color: #6e6e6e;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pc-price {
  margin-top: 14rpx;
  color: var(--color-primary);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}
.pc-price.muted-price {
  color: var(--color-muted);
  font-size: 26rpx;
  font-weight: 500;
}

.pc-actions {
  display: flex;
  align-items: stretch;
  border-top: 1rpx solid var(--color-line);
  background: #faf8f6;
}
.pc-act {
  flex: 1;
  text-align: center;
  padding: 22rpx 8rpx;
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 500;
  white-space: nowrap;
}
.pc-act-div {
  width: 1rpx;
  background: var(--color-line);
  margin: 16rpx 0;
  flex-shrink: 0;
}

.empty { text-align: center; padding: 80rpx 40rpx; }
.footer-tip { text-align: center; padding: 24rpx 0 48rpx; font-size: 24rpx; }

.chips-row { white-space: nowrap; margin-bottom: 8rpx; padding: 0 4rpx 8rpx; }
.chips-row .chip { display: inline-block; margin-right: 12rpx; }

.chips-row .chip-badge {
  margin-left: 8rpx;
  font-size: 20rpx;
  opacity: 0.85;
}
.chips-row .chip.active .chip-badge { opacity: 1; }
.chips-row .chip-manage {
  background: transparent;
  border: 1rpx dashed #c4bbb4;
  color: var(--color-primary);
  font-weight: 600;
}

.gm-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.gm-sheet {
  width: 100%;
  max-height: 70vh;
  border-radius: 24rpx 24rpx 0 0;
  padding: 8rpx 0 32rpx;
  margin: 0;
  box-sizing: border-box;
}
.gm-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 12rpx;
}
.gm-title { font-size: 32rpx; font-weight: 650; }
.gm-close { color: var(--color-muted); font-size: 28rpx; padding: 8rpx; }
.gm-create {
  margin: 8rpx 32rpx 16rpx;
  padding: 22rpx;
  text-align: center;
  color: var(--color-primary);
  font-weight: 600;
  background: #f5f0ec;
  border-radius: 16rpx;
}
.gm-list { max-height: 52vh; padding: 0 8rpx; }
.gm-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid var(--color-line);
}
.gm-row-main { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.gm-name { font-size: 30rpx; font-weight: 500; }
.gm-tag {
  font-size: 20rpx;
  color: #fff;
  background: var(--color-primary);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}
.gm-hint { color: var(--color-muted); font-size: 24rpx; flex-shrink: 0; margin-left: 16rpx; }
