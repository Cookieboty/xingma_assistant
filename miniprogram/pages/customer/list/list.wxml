<upload-float />
<view class="container">
  <view class="card head">
    <view class="section-title">客户</view>
    <view class="muted">分享卡片打开后自动建档；可搜昵称/openid、点进详情改等级</view>
  </view>

  <view class="card search-bar">
    <input class="input" placeholder="搜索昵称 / openid" value="{{q}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearch" />
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>

  <view class="card muted" wx:if="{{loading && !list.length}}">加载中…</view>
  <view class="card muted empty" wx:elif="{{!list.length}}">暂无客户。把商品分享出去后，对方打开即出现在这里。</view>

  <view class="card row" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <image wx:if="{{item.avatarUrl}}" class="avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
    <view wx:else class="avatar avatar-ph">{{item.nickShort}}</view>
    <view class="body">
      <view class="name">{{item.displayName}}</view>
      <view class="muted small">{{item.levelCode}} · rank {{item.rank}}</view>
    </view>
    <view class="arrow muted">›</view>
  </view>
</view>
