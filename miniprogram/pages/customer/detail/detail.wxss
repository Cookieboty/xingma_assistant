.section { font-weight: 600; margin-bottom: 12rpx; }
.picker { background: #f5f5f5; padding: 16rpx; border-radius: 8rpx; }
.input { background: #f5f5f5; padding: 12rpx 16rpx; border-radius: 8rpx; margin-top: 12rpx; width: 100%; box-sizing: border-box; }
