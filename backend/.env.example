# ========== 服务 ==========
PORT=3000
NODE_ENV=development
# 对外访问基址（Nginx 反代后的 HTTPS 域名）；API 路径保持 /api/*
APP_BASE_URL=https://xingma.visitworld.me

# ========== 微信小程序 ==========
# 默认租户 AppID（星马档口），与 migrations/003 种子一致
WECHAT_APP_ID=wx394d23ea099d8a01
# AppSecret：在 mp.weixin.qq.com → 开发管理 → 开发设置 获取。
# 只放在服务器 .env 或 tenants.wx_app_secret，绝不提交到仓库。留空时生产登录会返回明确报错。
WECHAT_APP_SECRET=
# true：跳过 jscode2session，用 code 派生假 openid（仅本地开发！生产必须 false）
DEV_FAKE_LOGIN=false

# ========== MySQL（DB_ENABLED=true 时生效；false 用内存仓库） ==========
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wool
DB_PASSWORD=please_change
DB_NAME=wool_stall

# ========== Redis（会话/限流预留，暂未使用） ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== JWT ==========
# 生产必须换成随机长串：openssl rand -hex 32
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# ========== 对象存储（mock|aliyun|cos） ==========
# mock/local：URL 形如 ${MEDIA_PUBLIC_BASE|/APP}/media/tenants/...
# aliyun：仍写本地 storage/ 供 OCR；同步 put 到 OSS，返回 OSS 公网 URL
OSS_PROVIDER=mock
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_PREFIX=chathub/chat-uploads/wool-stall
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 兼容 ChatHub 风格别名（可选 fallback）
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_OSS_BUCKET=
# ALIYUN_OSS_REGION=
# ALIYUN_OSS_ENDPOINT=
# ALIYUN_OSS_PREFIX=
# 私有桶：读链接短时签名（默认 3600s≈1h）；兼容旧名 OSS_SIGNED_TTL
OSS_SIGNED_URL_EXPIRES=3600
OSS_SIGNED_TTL=3600
# 对象 ACL：private（默认，配合私有桶）| public-read（旧公开桶）
OSS_OBJECT_ACL=private
# 仅调试公开桶时设 OSS_PUBLIC_READ=1（返回永久 URL，不签名）
# OSS_PUBLIC_READ=0
# 公开读基址（可选）；私有桶下 publicUrl 仍走签名，此值主要用于派生 host
# MEDIA_PUBLIC_BASE=https://chathub.oss-cn-hangzhou.aliyuncs.com
# MEDIA_SERVE_LOCAL=0
# 微信未加 OSS 合法域名时临时回退本机/API /media/

# 商品生图（OpenAI 兼容）
IMAGE_GEN_BASE_URL=https://image.aijws.com/v1
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=gpt-image-2-free
IMAGE_GEN_REF_MODE=task,edits
IMAGE_GEN_CONCURRENCY=2
IMAGE_GEN_TIMEOUT_MS=300000

# 多模态看图选封面（OpenAI 兼容）；密钥只放服务器 .env，勿进小程序/勿 commit
VISION_BASE_URL=https://api.xytoken.xyb2b.com/v1
VISION_API_KEY=
VISION_MODEL=Aerith-haiku-5.5
VISION_TIMEOUT_MS=60000
VISION_MAX_CANDIDATES=12
VISION_OCR_CONCURRENCY=3
# 仅本机 Mac 调试可开；线上 Linux 必须保持关闭（勿依赖 scripts/vision_ocr）
ENABLE_MAC_VISION_OCR=0

# 通用异步任务（MySQL jobs 表）
JOB_SCHEDULER=true
JOB_CONCURRENCY=2
JOB_POLL_MS=1500
JOB_AUTO_RETRY=true
# 无进度更新的 running 超过此时长视为陈旧并重排队（默认 45min）
JOB_STALE_MS=2700000
DEFAULT_PRODUCT_LEVEL_ID=pl_open
